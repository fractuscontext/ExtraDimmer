+
+    /// 0 = fully bright, 1 = fully black. Cosmetic curve for the recording
+    /// overlay only — just needs to look convincing on camera.
+    var demoDimLevel: Float {
+        if hardwareBrightness > 1 {
+            return Float(1.0 - hardwareBrightness / 100.0) * 0.85
+        } else {
+            let x = Float((100.0 - overlayBrightness) / 100.0)
+            return 0.85 + 0.15 * x   // stacks on top of hardware-minimum darkness
+        }
+    }
+    #endif
 
