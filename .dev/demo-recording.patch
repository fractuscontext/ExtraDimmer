+// MARK: - Demo Recording Overlay (recording aid only — compiled out of release builds)
+
+#if DEMO_RECORDING
+@MainActor
+final class DemoOverlayWindow {
+    private var window: NSWindow?
+
+    init() {
+        guard let screen = NSScreen.main else { return }
+
+        let window = NSWindow(
+            contentRect: screen.frame,
+            styleMask: [.borderless],
+            backing: .buffered,
+            defer: false,
+            screen: screen
+        )
+        window.isOpaque = false
+        window.backgroundColor = .black
+        window.ignoresMouseEvents = true           // clicks pass straight through
+        window.level = .normal                     // below the popover, above the desktop
+        window.collectionBehavior = [.canJoinAllSpaces, .stationary, .ignoresCycle]
+        window.isReleasedWhenClosed = false
+        window.alphaValue = 0
+        window.orderFrontRegardless()
+
+        self.window = window
+    }
+
+    /// pct: 0 = fully bright, 1 = fully black
+    func setDim(_ pct: Float) {
+        window?.alphaValue = CGFloat(max(0, min(1, pct)))
+    }
+}
+#endif
